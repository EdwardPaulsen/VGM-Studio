<Window x:Class="ZipArchiveEntrySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VGM_Studio"
        mc:Ignorable="d"
        Title="Choose a file" Height="500" Width="400" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10,10,10,10">
            <Label Name="FileNameLabel"></Label>
            <ListBox Name="MainListBox" Height="400" Margin="0,0,0,10"></ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="OKButton" Width ="120" Height="50" Margin="0,0,10,0" Content="_OK" IsDefault="True"></Button>
                <Button Name="CancelButton" Width ="120" Height="50" Content="_Cancel" IsCancel="True"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
