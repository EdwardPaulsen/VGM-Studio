<Page x:Class="VGMSingleExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VGM_Studio" d:DataContext="{d:DesignInstance Type=local:ExportPageViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VGMSingleExportPage">
    
    <Grid>
        <DockPanel>
            <Button x:Name="ExportButton" Content="E_xport" Height="Auto" Width="120" Margin="10" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ExportButtonMenu">
                        <MenuItem x:Name="ExportAsMIDIFileMenuItem" Header="As _MIDI file..."></MenuItem>
                        <MenuItem x:Name="ExportAsWAVFileMenuItem" Header="As _WAV file..."></MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Label DockPanel.Dock="Top" Content="Export" FontWeight="Bold" FontSize="18"/>
            <ScrollViewer DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Margin="0,10,0,0" FontSize="14" FontWeight="Bold"><Run Text="MIDI Options"/></TextBlock>
                    <Label FontWeight="Bold" Margin="0,0,0,0" Content="Tempo"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="240" Margin="10,0,0,0" Minimum="60" Maximum="200" TickFrequency="0.01" IsSnapToTickEnabled="True" LargeChange="1" SmallChange="0.01" Value="{Binding Path=MidiTempo}"></Slider>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text="{Binding Path=MidiTempo}"/><Run Text=" BPM"/>
                        </TextBlock>
                        <ComboBox x:Name="BpmComboBox" Margin="10,0,0,0" ItemsSource="{Binding Path=MidiTempos}" IsReadOnly="True"/>
                        <Button x:Name="AutodetectButton" Content="_Autodetect" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Label FontWeight="Bold" Margin="0,0,0,0" Content="Time Signature"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Margin="10,0,0,0" ItemsSource="{Binding Path=MidiNumerators}" SelectedValue="{Binding Path=MidiNumerator}"/>
                        <TextBlock Margin="10,0,10,0" VerticalAlignment="Center"><Run Text="/"/></TextBlock>
                        <ComboBox Width="Auto" ItemsSource="{Binding Path=MidiDenominators}" SelectedValue="{Binding Path=MidiDenominator}"/>
                    </StackPanel>
                    <Label FontWeight="Bold" Margin="0,0,0,0" Content="Pitch Bend Range"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="240" Margin="10,0,0,0" Minimum="1" Maximum="24" Value="{Binding Path=MidiPitchBendRange}"></Slider>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text="± "/><Run Text="{Binding Path=MidiPitchBendRange}"/><Run Text=" semitones"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" FontSize="14" FontWeight="Bold"><Run Text="WAV Options"/></TextBlock>
                    <Label FontWeight="Bold" Margin="0,0,0,0" Content="Sample rate scale"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SampleRateScaleComboBox" Margin="10,0,0,0" ItemsSource="{Binding Path=SampleRateScales}" SelectedValue="{Binding Path=SampleRateScale}"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run x:Name="SampleRateScaleTextRun" Text =""/>
                        </TextBlock>
                    </StackPanel>
                    <Label FontWeight="Bold" Margin="0,0,0,0" Content="Chip options"/>
                    <StackPanel x:Name="PSGStackPanel" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text ="PSG:"/>
                        </TextBlock>
                        <ComboBox x:Name="PSGEmuComboBox" Margin="10,0,0,0" ItemsSource="{Binding Path=PSGEmus}" SelectedValue="{Binding Path=PSGEmu}"/>
                    </StackPanel>
                    <StackPanel x:Name = "YM2612StackPanel" Orientation="Horizontal">
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text ="YM2612:"/>
                        </TextBlock>
                        <ComboBox x:Name="YM2612EmuComboBox" Margin="10,0,0,0" ItemsSource="{Binding Path=YM2612Emus}" SelectedValue="{Binding Path=YM2612Emu}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>

</Page>
